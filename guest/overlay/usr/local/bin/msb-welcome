#!/usr/bin/env bash
set -euo pipefail
state="${XDG_STATE_HOME:-$HOME/.local/state}/msb-omarchy"
mkdir -p "$state"
exec 9>"$state/welcome.lock"
flock -n 9 || exit 0
[[ -e "$state/welcomed" ]] && exit 0
omarchy-theme-set-gnome
gsettings set org.gnome.desktop.interface icon-theme Adwaita
gsettings set org.gnome.desktop.interface font-name "Noto Sans 11"
omarchy-notification-wait
omarchy-notification-send -u normal -t 10000 "Your desktop is ready" \
  $'⌘ + Enter opens Terminal. ⌘ + K shows shortcuts.\nThe folder in the bar opens files shared with your Mac.' \
  --exec msb-help
touch "$state/welcomed"
