#!/usr/bin/env python3
"""Capture a running guest without displacing its native window."""
import argparse
from pathlib import Path
import sys
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from omarchy import Desktop, Error, say

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("name", nargs="?", default="omarchy")
parser.add_argument("output", nargs="?", default="desktop.png")
args = parser.parse_args()
desktop = Desktop()
guest_path = "/tmp/msb-shot-" + uuid.uuid4().hex + ".png"
try:
    desktop.check_runtime()
    output = Path(args.output).expanduser().resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    desktop.msb("exec", "--timeout", "10s", args.name, "--", "msb-session", "grim", guest_path, timeout=15)
    desktop.msb("cp", f"{args.name}:{guest_path}", str(output), timeout=30)
    say(f"Screenshot: {output}")
except Error as error:
    say(str(error))
    sys.exit(1)
finally:
    if desktop.binary.exists():
        try:
            desktop.msb("exec", "--timeout", "3s", args.name, "--", "rm", "-f", guest_path,
                        capture=True, timeout=5, check=False)
        except Error:
            pass
