#!/usr/bin/env python3
"""Fail if the guest presents half-drawn frames (docs/assessment.md, "Half-drawn frames").

Opens and closes the Omarchy menu repeatedly through the display protocol. After
each close the last presented frame must equal the closed reference inside the
menu's area; a frame the compositor committed before llvmpipe finished shows
there as a stale band of llvmpipe tile rows. Validated on both profiles.
When the bug is present the reference frame itself can be stale, so the pixel
counts are a verdict, not a diagnosis. Needs Pillow. Attaches the one
display.sock viewer slot and closes an existing native viewer.
"""
import argparse
import hashlib
import json
from pathlib import Path
import socket
import sys
import time

from PIL import Image, ImageChops

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from omarchy import Desktop

KEYS = {"escape": 1, "space": 57, "super": 125}

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("sandbox")
parser.add_argument("--rounds", type=int, default=30)
parser.add_argument("--save", type=Path, help="Directory for the frames of failed rounds")
args = parser.parse_args()
path = Desktop().state_dir / "run/sandboxes" / hashlib.sha256(args.sandbox.encode()).hexdigest()[:24] / "display.sock"
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(str(path))
print("Attached the display viewer slot; reopen bin/msb display afterwards.", file=sys.stderr)
buffer = bytearray()


def receive(timeout):
    end = time.monotonic() + timeout
    while True:
        newline = buffer.find(b"\n")
        if newline >= 0:
            line = bytes(buffer[:newline])
            del buffer[:newline + 1]
            return json.loads(line)
        left = end - time.monotonic()
        if left <= 0:
            return None
        sock.settimeout(left)
        try:
            chunk = sock.recv(65536)
        except socket.timeout:
            return None
        if not chunk:
            raise SystemExit("Display server disconnected")
        buffer.extend(chunk)


def send(message):
    sock.sendall(json.dumps(message).encode() + b"\n")


def press(*names):
    for name in names:
        send({"t": "key", "code": KEYS[name], "down": True})
        time.sleep(0.03)
    for name in reversed(names):
        send({"t": "key", "code": KEYS[name], "down": False})
        time.sleep(0.03)


def settle(idle=0.8, first=3.0, limit=6.0):
    """The slot of the last frame before `idle` seconds without one, or None.

    The first frame may take longer than `idle` on a busy host."""
    slot, start = None, time.monotonic()
    while time.monotonic() - start < limit:
        message = receive(idle if slot is not None else first)
        if message is None:
            break
        if message.get("t") == "frame" and message.get("scanout") == 0:
            slot = message["slot"]
    return slot


config = None
while config is None:
    message = receive(10)
    if message is None:
        raise SystemExit("No scanout was configured")
    if message["t"] == "configure" and message["scanout"] == 0:
        config = message
width, height = config["width"], config["height"]
frames = open(config["path"], "rb")
# The menu is centred; the top bar with its clock stays outside this box.
box = (int(width * 0.36), int(height * 0.09), int(width * 0.64), int(height * 0.91))


def menu_area(slot):
    frames.seek(slot * width * height * 4)
    data = frames.read(width * height * 4)
    return Image.frombytes("RGB", (width, height), data, "raw", "BGRX").crop(box)


def changed(left, right):
    mask = ImageChops.difference(left, right).convert("L").point(lambda value: 255 if value else 0)
    return mask.histogram()[255], mask.getbbox()


# Park the software cursor in a corner, outside the compared area, and close
# a menu a previous run may have left open.
send({"t": "abs", "x": 32700, "y": 32700})
press("escape")
settle(1.0)
press("super", "space")
settle(1.5)
press("escape")
slot = settle(1.5)
if slot is None:
    raise SystemExit("The guest presented no frame; is the desktop running?")
reference = menu_area(slot)
failures = opened = 0
for index in range(args.rounds):
    press("super", "space")
    open_slot = settle()
    # Read each frame before the next key: the guest reuses the two slots.
    if open_slot is not None and changed(menu_area(open_slot), reference)[0] > 0:
        opened += 1
    time.sleep(0.4)
    press("escape")
    closed_slot = settle()
    closed = menu_area(closed_slot) if closed_slot is not None else None
    time.sleep(0.4)
    pixels, bounds = changed(closed, reference) if closed is not None else (0, None)
    if pixels:
        failures += 1
        print(f"round {index}: {pixels} pixels differ after closing the menu, within {bounds}")
        if args.save:
            args.save.mkdir(parents=True, exist_ok=True)
            closed.save(args.save / f"round-{index}-closed.png")
sock.close()
print(json.dumps({"sandbox": args.sandbox, "rounds": args.rounds, "menu_opened": opened,
                  "half_drawn_frames": failures}))
if opened < args.rounds // 2:
    raise SystemExit("The menu opened in fewer than half of the rounds; the check is inconclusive.")
if failures:
    raise SystemExit(f"{failures} half-drawn frame(s) presented")
