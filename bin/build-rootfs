#!/usr/bin/env bash
# Build the experience layer on the immutable, verified Omarchy base image.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
DOCKER=${DOCKER:-$(command -v docker || true)}
[[ -n "$DOCKER" ]] || DOCKER=/usr/local/bin/docker
[[ -x "$DOCKER" ]] || { echo "Docker is missing; set DOCKER to its executable path." >&2; exit 1; }
read_pin() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$ROOT/config/release.json" "$1"; }
TAG=${TAG:-$(read_pin build_tag)}
base=$(read_pin base_image)
mkdir -p "$ROOT/guest/build"
python3 - "$ROOT" "$TAG" "$base" <<'PY'
import hashlib
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone
root = Path(sys.argv[1])
digest = hashlib.sha256()
inputs = [root / "guest/Dockerfile", root / "config/release.json", root / "bin/build-rootfs"]
inputs += sorted(p for p in (root / "guest/overlay").rglob("*") if p.is_file())
for path in inputs:
    digest.update(str(path.relative_to(root)).encode() + b"\0" + path.read_bytes())
head = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
dirty = subprocess.check_output(["git", "-C", str(root), "status", "--porcelain"], text=True).strip()
with (root / "guest/build/versions").open("w") as out:
    out.write(f"base {sys.argv[3]}\n")
    out.write(f"msb-omarchy {head}{'-dirty' if dirty else ''}\n")
    out.write(f"build-input-sha256 {digest.hexdigest()}\n")
    out.write(f"image {sys.argv[2]}\n")
    out.write(f"built {datetime.now(timezone.utc).isoformat()}\n")
PY
"$DOCKER" build --platform linux/arm64 --build-arg "BASE_IMAGE=$base" -t "$TAG" "$ROOT/guest"
"$DOCKER" run --rm --platform linux/arm64 "$TAG" /usr/local/bin/msb-image-check
[[ "${NO_LOAD:-}" == 1 ]] && exit 0
"$DOCKER" save "$TAG" | "$ROOT/bin/msb" load
# Only a successfully checked AND loaded image becomes this checkout's default.
python3 - "$ROOT" "$TAG" "$DOCKER" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, str(Path(sys.argv[1]) / "lib"))
from omarchy import Desktop, write_json, execute, checksum
image_id = execute([sys.argv[3], "image", "inspect", "--format", "{{.Id}}", sys.argv[2]], capture=True).stdout.strip()
write_json(Desktop().state_dir / "omarchy/image.json", {"tag": sys.argv[2], "image_id": image_id, "versions_sha256": checksum(Path(sys.argv[1]) / "guest/build/versions")})
PY
echo "Image loaded. bin/run will use $TAG for new desktops."
